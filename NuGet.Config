<?xml version='1.0' encoding='utf-8'?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="xsr-local" value="artifacts/xsr-feed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="xsr-local">
      <package pattern="Nexa.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>